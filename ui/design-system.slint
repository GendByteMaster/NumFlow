import { Palette, Slider } from "std-widgets.slint";

// Semantic tokens keep the shared UI calm and platform-adaptive. The system palette supplies
// light/dark appearance and native contrast choices; components should not need raw colors.
export global NumFlowTheme {
    in property <brush> background: Palette.background;
    in property <brush> surface: Palette.background;
    in property <brush> window-material: Palette.background.with-alpha(0.88);
    in property <brush> window-material-fallback: Palette.background.with-alpha(0.93);
    in property <brush> background-glaze: @linear-gradient(135deg, #2563eb12 0%, #2563eb04 48%, #ffffff09 100%);
    in property <brush> surface-glass: Palette.foreground.with-alpha(0.07);
    in property <brush> surface-glass-elevated: Palette.foreground.with-alpha(0.12);
    in property <brush> surface-glass-hover: Palette.foreground.with-alpha(0.08);
    in property <brush> surface-glass-pressed: Palette.foreground.with-alpha(0.13);
    in property <brush> control-surface: Palette.foreground.with-alpha(0.10);
    in property <brush> control-hover: Palette.foreground.with-alpha(0.16);
    in property <brush> control-selected: #2563eb26;
    in property <brush> text-primary: Palette.foreground;
    in property <brush> text-secondary: Palette.alternate-foreground;
    in property <brush> text-tertiary: Palette.alternate-foreground.with-alpha(0.72);
    in property <brush> border-subtle: Palette.foreground.with-alpha(0.28);
    in property <brush> separator: Palette.foreground.with-alpha(0.22);
    in property <color> accent: #2563eb;
    in property <brush> accent-muted: #2563eb18;
    in property <color> accent-foreground: #ffffff;
    in property <color> focus-ring: #2563eb;
    in property <color> status-active: #16803c;
    in property <color> destructive: #c62828;
    in property <brush> destructive-soft: #c6282818;
    in property <color> shadow-window: #00000038;
    in property <color> shadow-elevated: #00000024;
    in property <color> glass-highlight: #ffffff16;
    in property <length> shadow-window-blur: 18px;
    in property <length> shadow-elevated-blur: 12px;

    in property <length> spacing-xs: 4px;
    in property <length> spacing-sm: 8px;
    in property <length> spacing-md: 12px;
    in property <length> spacing-lg: 16px;
    in property <length> radius-small: 7px;
    in property <length> radius-medium: 9px;
    in property <length> radius-large: 12px;
    in property <length> control-height: 32px;
    in property <length> row-height: 36px;
    in property <length> label-column-width: 92px;
    in property <length> value-column-width: 82px;

    // Transient HUD material is separate from the main window material.
    in property <brush> hud-material: surface-glass-elevated;
}

export component Separator inherits Rectangle {
    min-height: 1px;
    max-height: 1px;
    background: NumFlowTheme.separator;
}

component SegmentedCell inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <bool> reduced-motion: false;
    callback clicked();

    background: transparent;
    border-radius: NumFlowTheme.radius-small;
    border-width: keyboard-focus.has-focus ? 2px : 0px;
    border-color: keyboard-focus.has-focus ? NumFlowTheme.focus-ring : transparent;
    opacity: root.enabled ? 1 : 0.48;

    hover-surface := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: NumFlowTheme.radius-small;
        background: interaction.pressed ? NumFlowTheme.surface-glass-pressed : NumFlowTheme.control-hover;
        opacity: interaction.pressed ? 1 : interaction.has-hover && root.enabled ? 1 : 0;
        animate opacity {
            duration: root.reduced-motion ? 0ms : 140ms;
            easing: ease-out;
        }
    }

    HorizontalLayout {
        padding-left: NumFlowTheme.spacing-sm;
        padding-right: NumFlowTheme.spacing-sm;
        spacing: 5px;
        alignment: center;

        Text {
            text: root.selected ? "✓" : "";
            color: NumFlowTheme.accent;
            font-size: 10px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: NumFlowTheme.text-primary;
            font-size: 12px;
            font-weight: root.selected ? 600 : 450;
            vertical-alignment: center;
        }
    }

    keyboard-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        accessible-role: radio-button;
        accessible-label: root.label;
        accessible-checkable: true;
        accessible-checked: root.selected;
        accessible-action-default => { root.clicked(); }

        KeyBinding { keys: @keys(Return); activated => { root.clicked(); } }
        KeyBinding { keys: @keys(Space); activated => { root.clicked(); } }

        interaction := TouchArea {
            enabled: root.enabled;
            clicked => {
                keyboard-focus.focus();
                root.clicked();
            }
        }
    }
}

export component SegmentedControl inherits Rectangle {
    in property <string> first-label;
    in property <string> second-label;
    in property <string> third-label;
    in-out property <int> selected-index: 0;
    in property <bool> enabled: true;
    in property <bool> reduced-motion: false;
    callback selected(int);

    private property <length> segment-width: (root.width - 6px) / 3;

    min-height: NumFlowTheme.control-height;
    max-height: NumFlowTheme.control-height;
    background: NumFlowTheme.control-surface;
    border-width: 1px;
    border-color: NumFlowTheme.separator;
    border-radius: NumFlowTheme.radius-medium;
    opacity: root.enabled ? 1 : 0.58;

    selected-indicator := Rectangle {
        x: root.selected-index == 0
            ? 3px
            : root.selected-index == 1
                ? 3px + root.segment-width
                : 3px + root.segment-width * 2;
        y: 3px;
        width: root.segment-width;
        height: root.height - 6px;
        background: NumFlowTheme.control-selected;
        border-width: 0px;
        border-color: transparent;
        border-radius: NumFlowTheme.radius-small;

        animate x {
            duration: root.reduced-motion ? 0ms : 150ms;
            easing: ease-out;
        }
    }

    SegmentedCell {
        x: 3px;
        y: 3px;
        width: root.segment-width;
        height: root.height - 6px;
        label: root.first-label;
        selected: root.selected-index == 0;
        enabled: root.enabled;
        reduced-motion: root.reduced-motion;
        clicked => { root.selected-index = 0; root.selected(0); }
    }

    SegmentedCell {
        x: 3px + root.segment-width;
        y: 3px;
        width: root.segment-width;
        height: root.height - 6px;
        label: root.second-label;
        selected: root.selected-index == 1;
        enabled: root.enabled;
        reduced-motion: root.reduced-motion;
        clicked => { root.selected-index = 1; root.selected(1); }
    }

    SegmentedCell {
        x: 3px + root.segment-width * 2;
        y: 3px;
        width: root.segment-width;
        height: root.height - 6px;
        label: root.third-label;
        selected: root.selected-index == 2;
        enabled: root.enabled;
        reduced-motion: root.reduced-motion;
        clicked => { root.selected-index = 2; root.selected(2); }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    in property <bool> reduced-motion: false;
    in property <string> a11y-label: "Toggle";
    callback toggled(bool);

    min-width: 44px;
    max-width: 44px;
    min-height: 28px;
    max-height: 28px;
    border-radius: 14px;
    border-width: keyboard-focus.has-focus ? 2px : 1px;
    border-color: keyboard-focus.has-focus
        ? NumFlowTheme.focus-ring
        : root.checked
            ? NumFlowTheme.accent
            : NumFlowTheme.separator;
    background: root.checked ? NumFlowTheme.accent : NumFlowTheme.control-surface;
    opacity: root.enabled ? 1 : 0.48;

    knob := Rectangle {
        x: root.checked ? root.width - self.width - 4px : 4px;
        y: 4px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: NumFlowTheme.accent-foreground;

        animate x {
            duration: root.reduced-motion ? 0ms : 160ms;
            easing: ease-out;
        }
    }

    keyboard-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        accessible-role: switch;
        accessible-label: root.a11y-label;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-action-default => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }

        KeyBinding {
            keys: @keys(Return);
            activated => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
        KeyBinding {
            keys: @keys(Space);
            activated => {
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }

        interaction := TouchArea {
            enabled: root.enabled;
            clicked => {
                keyboard-focus.focus();
                root.checked = !root.checked;
                root.toggled(root.checked);
            }
        }
    }
}

export component SliderControl inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <float> step: 1;
    in property <bool> enabled: true;
    in property <string> a11y-label: "Slider";
    callback changed(float);

    private property <float> fraction: root.maximum > root.minimum
        ? Math.max(0, Math.min(1, (root.value - root.minimum) / (root.maximum - root.minimum)))
        : 0;

    min-height: NumFlowTheme.control-height;
    max-height: NumFlowTheme.control-height;
    background: transparent;
    opacity: root.enabled ? 1 : 0.45;

    track := Rectangle {
        x: 9px;
        y: (root.height - self.height) / 2;
        width: root.width - 18px;
        height: 4px;
        border-radius: 2px;
        background: NumFlowTheme.control-surface;
    }

    Rectangle {
        x: track.x;
        y: track.y;
        width: track.width * root.fraction;
        height: track.height;
        border-radius: track.border-radius;
        background: NumFlowTheme.accent;
    }

    focus-ring := Rectangle {
        x: knob.x - 3px;
        y: knob.y - 3px;
        width: knob.width + 6px;
        height: knob.height + 6px;
        border-radius: self.width / 2;
        border-width: input.has-focus ? 2px : 0px;
        border-color: NumFlowTheme.focus-ring;
        background: transparent;
        opacity: input.has-focus ? 1 : 0;
    }

    knob := Rectangle {
        x: track.x + track.width * root.fraction - self.width / 2;
        y: (root.height - self.height) / 2;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: NumFlowTheme.accent-foreground;
        border-width: 2px;
        border-color: NumFlowTheme.accent;
    }

    input := Slider {
        width: parent.width;
        height: parent.height;
        opacity: 0;
        enabled: root.enabled;
        accessible-label: root.a11y-label;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        value <=> root.value;
        changed(value) => { root.changed(value); }
    }
}

export component UtilityButton inherits Rectangle {
    in property <string> text;
    in property <bool> destructive: false;
    in property <bool> enabled: true;
    in property <bool> reduced-motion: false;
    in property <bool> more-glyph: false;
    in property <string> a11y-label: "";
    callback clicked();

    min-height: NumFlowTheme.control-height;
    max-height: NumFlowTheme.control-height;
    min-width: NumFlowTheme.control-height;
    border-radius: NumFlowTheme.radius-small;
    border-width: keyboard-focus.has-focus ? 2px : 1px;
    border-color: keyboard-focus.has-focus
        ? NumFlowTheme.focus-ring
        : root.destructive
            ? NumFlowTheme.destructive
            : NumFlowTheme.separator;
    background: NumFlowTheme.control-surface;
    opacity: root.enabled ? 1 : 0.48;

    hover-surface := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: interaction.pressed
            ? root.destructive ? NumFlowTheme.destructive-soft : NumFlowTheme.surface-glass-pressed
            : root.destructive ? NumFlowTheme.destructive-soft : NumFlowTheme.control-hover;
        opacity: interaction.pressed ? 1 : interaction.has-hover && root.enabled ? 1 : 0;
        animate opacity {
            duration: root.reduced-motion ? 0ms : 140ms;
            easing: ease-out;
        }
    }

    Text {
        text: root.more-glyph ? "" : root.text;
        color: root.destructive ? NumFlowTheme.destructive : NumFlowTheme.text-primary;
        font-size: 12px;
        font-weight: 550;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Rectangle {
        x: root.width / 2 - 7px;
        y: root.height / 2 - 1px;
        width: 3px;
        height: 3px;
        border-radius: 2px;
        background: NumFlowTheme.text-primary;
        opacity: root.more-glyph ? 0.88 : 0;
    }
    Rectangle {
        x: root.width / 2 - 1px;
        y: root.height / 2 - 1px;
        width: 3px;
        height: 3px;
        border-radius: 2px;
        background: NumFlowTheme.text-primary;
        opacity: root.more-glyph ? 0.88 : 0;
    }
    Rectangle {
        x: root.width / 2 + 5px;
        y: root.height / 2 - 1px;
        width: 3px;
        height: 3px;
        border-radius: 2px;
        background: NumFlowTheme.text-primary;
        opacity: root.more-glyph ? 0.88 : 0;
    }

    keyboard-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        accessible-role: button;
        accessible-label: root.a11y-label == "" ? root.text : root.a11y-label;
        accessible-action-default => { root.clicked(); }

        KeyBinding { keys: @keys(Return); activated => { root.clicked(); } }
        KeyBinding { keys: @keys(Space); activated => { root.clicked(); } }

        interaction := TouchArea {
            enabled: root.enabled;
            clicked => {
                keyboard-focus.focus();
                root.clicked();
            }
        }
    }
}

export component DisclosureRow inherits Rectangle {
    in property <string> label;
    in property <bool> expanded: false;
    in property <bool> reduced-motion: false;
    callback toggled();

    min-height: NumFlowTheme.row-height;
    max-height: NumFlowTheme.row-height;
    border-radius: NumFlowTheme.radius-small;
    background: transparent;
    border-width: keyboard-focus.has-focus ? 2px : 0px;
    border-color: keyboard-focus.has-focus ? NumFlowTheme.focus-ring : transparent;

    hover-surface := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: interaction.pressed ? NumFlowTheme.surface-glass-pressed : NumFlowTheme.control-hover;
        opacity: interaction.pressed ? 1 : interaction.has-hover ? 1 : 0;
        animate opacity {
            duration: root.reduced-motion ? 0ms : 140ms;
            easing: ease-out;
        }
    }

    HorizontalLayout {
        padding-left: 2px;
        padding-right: 4px;
        spacing: NumFlowTheme.spacing-sm;
        cross-axis-alignment: center;

        Text {
            text: root.label;
            color: NumFlowTheme.text-primary;
            font-size: 12px;
            font-weight: 550;
        }

        Rectangle { horizontal-stretch: 1; background: transparent; }

        Text {
            text: "›";
            color: root.expanded ? NumFlowTheme.accent : NumFlowTheme.text-secondary;
            font-size: 17px;
            font-weight: 500;
            opacity: interaction.has-hover || root.expanded ? 1 : 0.82;
            transform-rotation: root.expanded ? 90deg : 0deg;
            animate opacity { duration: root.reduced-motion ? 0ms : 140ms; }
            animate transform-rotation {
                duration: root.reduced-motion ? 0ms : 150ms;
                easing: ease-out;
            }
        }
    }

    keyboard-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        accessible-role: button;
        accessible-label: root.label;
        accessible-action-default => { root.toggled(); }

        KeyBinding { keys: @keys(Return); activated => { root.toggled(); } }
        KeyBinding { keys: @keys(Space); activated => { root.toggled(); } }

        interaction := TouchArea {
            clicked => {
                keyboard-focus.focus();
                root.toggled();
            }
        }
    }
}

export component MappingRow inherits Rectangle {
    in property <string> key-label;
    in property <string> action-label;

    min-height: 27px;
    max-height: 27px;
    background: transparent;

    HorizontalLayout {
        spacing: 10px;
        cross-axis-alignment: center;

        Rectangle {
            min-width: 38px;
            max-width: 38px;
            min-height: 22px;
            max-height: 22px;
            border-radius: 6px;
            background: NumFlowTheme.control-surface;
            border-width: 1px;
            border-color: NumFlowTheme.border-subtle;

            Text {
                text: root.key-label;
                color: NumFlowTheme.text-primary;
                font-size: 11px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.action-label;
            color: NumFlowTheme.text-secondary;
            font-size: 11px;
            overflow: elide;
        }
    }
}

export component MenuAction inherits Rectangle {
    in property <string> text;
    in property <bool> destructive: false;
    in property <bool> reduced-motion: false;
    callback clicked();

    min-height: 34px;
    max-height: 34px;
    border-radius: NumFlowTheme.radius-small;
    background: transparent;
    border-width: keyboard-focus.has-focus ? 2px : 0px;
    border-color: keyboard-focus.has-focus ? NumFlowTheme.focus-ring : transparent;

    hover-surface := Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: parent.border-radius;
        background: interaction.pressed
            ? root.destructive ? NumFlowTheme.destructive-soft : NumFlowTheme.surface-glass-pressed
            : root.destructive ? NumFlowTheme.destructive-soft : NumFlowTheme.control-hover;
        opacity: interaction.pressed ? 1 : interaction.has-hover ? 1 : 0;
        animate opacity {
            duration: root.reduced-motion ? 0ms : 140ms;
            easing: ease-out;
        }
    }

    Text {
        x: 10px;
        width: parent.width - 20px;
        text: root.text;
        color: root.destructive ? NumFlowTheme.destructive : NumFlowTheme.text-primary;
        font-size: 12px;
        font-weight: root.destructive ? 550 : 450;
        vertical-alignment: center;
    }

    keyboard-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        focus-on-click: true;
        focus-on-tab-navigation: true;
        accessible-role: button;
        accessible-label: root.text;
        accessible-action-default => { root.clicked(); }

        KeyBinding { keys: @keys(Return); activated => { root.clicked(); } }
        KeyBinding { keys: @keys(Space); activated => { root.clicked(); } }

        interaction := TouchArea {
            clicked => {
                keyboard-focus.focus();
                root.clicked();
            }
        }
    }
}
