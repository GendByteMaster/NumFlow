import { Button, ComboBox, Palette, Slider, Switch } from "std-widgets.slint";
export * from "hud.slint";

export enum MouseButtonMode {
    left,
    right,
    middle,
}

component SurfaceCard inherits Rectangle {
    background: Palette.alternate-background;
    border-width: 1px;
    border-color: Palette.border;
    border-radius: 16px;
}

component StatusItem inherits Rectangle {
    in property <image> icon-source;
    in property <string> title;
    in property <string> value;

    background: transparent;
    min-height: 58px;

    HorizontalLayout {
        padding: 8px;
        spacing: 10px;

        Image {
            source: root.icon-source;
            width: 32px;
            height: 32px;
            image-fit: contain;
            accessible-role: none;
        }

        VerticalLayout {
            spacing: 2px;

            Text {
                text: root.title;
                color: Palette.alternate-foreground;
                font-size: 12px;
            }

            Text {
                text: root.value;
                color: Palette.foreground;
                font-size: 15px;
                font-weight: 600;
            }
        }
    }
}

component KeyTile inherits Rectangle {
    in property <string> key-label;
    in property <string> action-label;
    in property <bool> active: false;

    min-width: 88px;
    min-height: 52px;
    border-radius: 12px;
    border-width: active ? 2px : 1px;
    border-color: active ? Palette.accent-background : Palette.border;
    background: active ? Palette.accent-background : Palette.control-background;

    VerticalLayout {
        padding: 6px;
        spacing: 1px;

        Text {
            text: root.key-label;
            color: active ? Palette.accent-foreground : Palette.control-foreground;
            font-size: 16px;
            font-weight: 600;
            horizontal-alignment: center;
        }

        Text {
            text: active ? "Active · " + root.action-label : root.action-label;
            color: active ? Palette.accent-foreground : Palette.alternate-foreground;
            font-size: 10px;
            horizontal-alignment: center;
        }
    }
}

export component AppWindow inherits Window {
    title: "NumFlow";
    width: 620px;
    height: root.bindings-editor-visible ? 962px : 842px;
    background: Palette.background;

    in-out property <bool> numflow-enabled: false;
    in-out property <float> pointer-speed: 180;
    in-out property <float> pointer-acceleration: 900;
    in-out property <bool> precision-enabled: false;
    in-out property <MouseButtonMode> active-button: MouseButtonMode.left;
    in-out property <string> active-key: "";
    in-out property <bool> hud-enabled: true;
    in-out property <string> active-profile: "Normal";
    in-out property <int> binding-key-index: 0;
    in-out property <int> binding-action-index: 1;
    in-out property <string> numpad-one-label: "Down-left";
    in-out property <string> numpad-two-label: "Down";
    in-out property <string> numpad-three-label: "Down-right";
    in-out property <string> numpad-four-label: "Left";
    in-out property <string> numpad-five-label: "Click";
    in-out property <string> numpad-six-label: "Right";
    in-out property <string> numpad-seven-label: "Up-left";
    in-out property <string> numpad-eight-label: "Up";
    in-out property <string> numpad-nine-label: "Up-right";

    private property <bool> bindings-editor-visible: false;

    callback enabled-toggled(bool);
    callback mouse-button-changed(MouseButtonMode);
    callback precision-toggled(bool);
    callback speed-changed(float);
    callback acceleration-changed(float);
    callback hud-toggled(bool);
    callback profile-changed(string);
    callback binding-key-changed(int);
    callback binding-action-changed(int);
    callback reset-bindings();
    callback reset-defaults();

    private property <string> active-button-label:
        root.active-button == MouseButtonMode.left ? "Left" :
        root.active-button == MouseButtonMode.right ? "Right" : "Middle";

    private property <image> active-button-icon:
        root.active-button == MouseButtonMode.left
            ? @image-url("../assets/icons/numflow/mouse-left.svg")
            : root.active-button == MouseButtonMode.right
                ? @image-url("../assets/icons/numflow/mouse-right.svg")
                : @image-url("../assets/icons/numflow/mouse-middle.svg");

    VerticalLayout {
        padding: 22px;
        spacing: 12px;

        HorizontalLayout {
            min-height: 50px;
            spacing: 12px;

            Image {
                source: @image-url("../assets/numflow-icon.svg");
                width: 38px;
                height: 38px;
                image-fit: contain;
                accessible-role: none;
            }

            VerticalLayout {
                spacing: 2px;

                Text {
                    text: "NumFlow";
                    color: Palette.foreground;
                    font-size: 26px;
                    font-weight: 700;
                }

                Text {
                    text: "Precise pointer control from your keyboard.";
                    color: Palette.alternate-foreground;
                    font-size: 12px;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            Switch {
                text: root.numflow-enabled ? "On" : "Off";
                checked <=> root.numflow-enabled;
                toggled => {
                    root.enabled-toggled(self.checked);
                }
            }
        }

        SurfaceCard {
            height: 76px;

            HorizontalLayout {
                padding: 7px;
                spacing: 4px;

                StatusItem {
                    horizontal-stretch: 1;
                    icon-source: root.numflow-enabled
                        ? @image-url("../assets/icons/numflow/power-on.svg")
                        : @image-url("../assets/icons/numflow/power-off.svg");
                    title: "NumFlow";
                    value: root.numflow-enabled ? "On" : "Off";
                }

                Rectangle { width: 1px; background: Palette.border; }

                StatusItem {
                    horizontal-stretch: 1;
                    icon-source: root.active-button-icon;
                    title: "Mouse button";
                    value: root.active-button-label;
                }

                Rectangle { width: 1px; background: Palette.border; }

                StatusItem {
                    horizontal-stretch: 1;
                    icon-source: @image-url("../assets/icons/numflow/precision-mode.svg");
                    title: "Precision";
                    value: root.precision-enabled ? "On" : "Off";
                }
            }
        }

        SurfaceCard {
            height: 224px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: "NumPad";
                    color: Palette.foreground;
                    font-size: 16px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;
                    KeyTile { key-label: "↖ 7"; action-label: root.numpad-seven-label; active: root.active-key == "7"; }
                    KeyTile { key-label: "↑ 8"; action-label: root.numpad-eight-label; active: root.active-key == "8"; }
                    KeyTile { key-label: "9 ↗"; action-label: root.numpad-nine-label; active: root.active-key == "9"; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    KeyTile { key-label: "← 4"; action-label: root.numpad-four-label; active: root.active-key == "4"; }
                    KeyTile { key-label: "5"; action-label: root.numpad-five-label; active: root.active-key == "5"; }
                    KeyTile { key-label: "6 →"; action-label: root.numpad-six-label; active: root.active-key == "6"; }
                }

                HorizontalLayout {
                    spacing: 8px;
                    KeyTile { key-label: "↙ 1"; action-label: root.numpad-one-label; active: root.active-key == "1"; }
                    KeyTile { key-label: "↓ 2"; action-label: root.numpad-two-label; active: root.active-key == "2"; }
                    KeyTile { key-label: "3 ↘"; action-label: root.numpad-three-label; active: root.active-key == "3"; }
                }
            }
        }

        SurfaceCard {
            height: 100px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                Text {
                    text: "Mouse button · Selected: " + root.active-button-label;
                    color: Palette.foreground;
                    font-size: 15px;
                    font-weight: 600;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Button {
                        horizontal-stretch: 1;
                        text: "Left";
                        icon: @image-url("../assets/icons/numflow/mouse-left.svg");
                        icon-size: 24px;
                        primary: root.active-button == MouseButtonMode.left;
                        clicked => {
                            root.active-button = MouseButtonMode.left;
                            root.mouse-button-changed(MouseButtonMode.left);
                        }
                    }

                    Button {
                        horizontal-stretch: 1;
                        text: "Right";
                        icon: @image-url("../assets/icons/numflow/mouse-right.svg");
                        icon-size: 24px;
                        primary: root.active-button == MouseButtonMode.right;
                        clicked => {
                            root.active-button = MouseButtonMode.right;
                            root.mouse-button-changed(MouseButtonMode.right);
                        }
                    }

                    Button {
                        horizontal-stretch: 1;
                        text: "Middle";
                        icon: @image-url("../assets/icons/numflow/mouse-middle.svg");
                        icon-size: 24px;
                        primary: root.active-button == MouseButtonMode.middle;
                        clicked => {
                            root.active-button = MouseButtonMode.middle;
                            root.mouse-button-changed(MouseButtonMode.middle);
                        }
                    }
                }
            }
        }

        SurfaceCard {
            height: 250px;

            VerticalLayout {
                padding: 14px;
                spacing: 7px;

                Text {
                    text: "Pointer";
                    color: Palette.foreground;
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    text: "Profile · " + root.active-profile;
                    color: Palette.alternate-foreground;
                    font-size: 12px;
                }

                HorizontalLayout {
                    spacing: 8px;

                    Button {
                        horizontal-stretch: 1;
                        text: "Normal";
                        primary: root.active-profile == "Normal";
                        clicked => {
                            root.active-profile = "Normal";
                            root.profile-changed("Normal");
                        }
                    }

                    Button {
                        horizontal-stretch: 1;
                        text: "Precision";
                        primary: root.active-profile == "Precision";
                        clicked => {
                            root.active-profile = "Precision";
                            root.profile-changed("Precision");
                        }
                    }

                    Button {
                        horizontal-stretch: 1;
                        text: "Fast";
                        primary: root.active-profile == "Fast";
                        clicked => {
                            root.active-profile = "Fast";
                            root.profile-changed("Fast");
                        }
                    }
                }

                Text {
                    text: "Speed · \{Math.round(root.pointer-speed)} px/s";
                    color: Palette.alternate-foreground;
                    font-size: 12px;
                }

                Slider {
                    accessible-label: "Pointer speed";
                    minimum: 40;
                    maximum: 800;
                    step: 10;
                    value <=> root.pointer-speed;
                    changed(value) => { root.speed-changed(value); }
                }

                Text {
                    text: "Acceleration · \{Math.round(root.pointer-acceleration)} px/s²";
                    color: Palette.alternate-foreground;
                    font-size: 12px;
                }

                Slider {
                    accessible-label: "Pointer acceleration";
                    minimum: 0;
                    maximum: 3000;
                    step: 50;
                    value <=> root.pointer-acceleration;
                    changed(value) => { root.acceleration-changed(value); }
                }

                HorizontalLayout {
                    min-height: 34px;
                    spacing: 8px;

                    Image {
                        source: @image-url("../assets/icons/numflow/precision-mode.svg");
                        width: 26px;
                        height: 26px;
                        image-fit: contain;
                        accessible-role: none;
                    }

                    Switch {
                        text: "Precision mode";
                        checked <=> root.precision-enabled;
                        toggled => { root.precision-toggled(self.checked); }
                    }
                }
            }
        }

        if root.bindings-editor-visible: SurfaceCard {
            height: 108px;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                HorizontalLayout {
                    Text {
                        text: "Key bindings · " + root.active-profile;
                        color: Palette.foreground;
                        font-size: 15px;
                        font-weight: 600;
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    Text {
                        text: "Changes apply immediately";
                        color: Palette.alternate-foreground;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;

                    ComboBox {
                        horizontal-stretch: 1;
                        accessible-label: "NumPad key";
                        model: [
                            "Num 8", "Num 2", "Num 4", "Num 6", "Num 7",
                            "Num 9", "Num 1", "Num 3", "Num 5", "Num +",
                            "Num 0", "Num .", "Num /", "Num *", "Num -"
                        ];
                        current-index <=> root.binding-key-index;
                        selected(value) => {
                            root.binding-key-changed(self.current-index);
                        }
                    }

                    ComboBox {
                        horizontal-stretch: 2;
                        accessible-label: "Binding action";
                        model: [
                            "Unbound",
                            "Move up", "Move down", "Move left", "Move right",
                            "Move up-left", "Move up-right", "Move down-left", "Move down-right",
                            "Single click", "Double click", "Hold / drag", "Release drag",
                            "Select left button", "Select right button", "Select middle button",
                            "Toggle NumFlow", "Enable NumFlow", "Disable NumFlow",
                            "Precision on", "Precision off"
                        ];
                        current-index <=> root.binding-action-index;
                        selected(value) => {
                            root.binding-action-changed(self.current-index);
                        }
                    }

                    Button {
                        text: "Reset bindings";
                        clicked => { root.reset-bindings(); }
                    }
                }
            }
        }

        HorizontalLayout {
            min-height: 36px;
            spacing: 10px;

            Text {
                text: "Saved automatically";
                color: Palette.alternate-foreground;
                font-size: 11px;
                vertical-alignment: center;
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            Switch {
                text: "HUD";
                checked <=> root.hud-enabled;
                toggled => { root.hud-toggled(self.checked); }
            }

            Button {
                text: root.bindings-editor-visible ? "Done" : "Bindings…";
                clicked => { root.bindings-editor-visible = !root.bindings-editor-visible; }
            }

            Button {
                text: "Reset to defaults";
                clicked => { root.reset-defaults(); }
            }
        }
    }
}
