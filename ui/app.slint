import { Button, ComboBox } from "std-widgets.slint";
import {
    DisclosureRow, MappingRow, MenuAction, NumFlowTheme, SegmentedControl, Separator,
    SliderControl, Toggle, UtilityButton
} from "design-system.slint";
export * from "hud.slint";

export enum MouseButtonMode {
    left,
    right,
    middle,
}

export component AppWindow inherits Window {
    title: "NumFlow";
    icon: @image-url("../assets/numflow-icon.svg");
    preferred-width: 400px;
    preferred-height: 354px;
    min-width: 380px;
    max-width: 420px;
    height: root.advanced-open ? 470px : 354px;
    background: root.platform-backdrop-available
        ? NumFlowTheme.window-material
        : NumFlowTheme.window-material-fallback;

    animate height {
        duration: root.reduced-motion ? 0ms : 160ms;
        easing: ease-out;
    }

    in-out property <bool> numflow-enabled: false;
    in-out property <float> pointer-speed: 180;
    in-out property <float> pointer-acceleration: 900;
    in-out property <bool> precision-enabled: false;
    in-out property <MouseButtonMode> active-button: MouseButtonMode.left;
    in-out property <string> active-key: "";
    in-out property <bool> hud-enabled: true;
    in-out property <bool> sounds-enabled: true;
    in-out property <float> sound-volume: 25;
    in-out property <string> active-profile: "Normal";
    in-out property <int> binding-key-index: 0;
    in-out property <int> binding-action-index: 1;
    in property <bool> platform-backdrop-available: false;
    in-out property <string> numpad-zero-label: "Hold / drag";
    in-out property <string> numpad-one-label: "Down-left";
    in-out property <string> numpad-two-label: "Down";
    in-out property <string> numpad-three-label: "Down-right";
    in-out property <string> numpad-four-label: "Left";
    in-out property <string> numpad-five-label: "Click";
    in-out property <string> numpad-six-label: "Right";
    in-out property <string> numpad-seven-label: "Up-left";
    in-out property <string> numpad-eight-label: "Up";
    in-out property <string> numpad-nine-label: "Up-right";
    in-out property <string> numpad-add-label: "Double click";
    in-out property <string> numpad-decimal-label: "Release";
    in property <bool> reduced-motion: false;

    private property <bool> advanced-open: false;
    private property <bool> saved-visible: false;

    callback enabled-toggled(bool);
    callback mouse-button-changed(MouseButtonMode);
    callback precision-toggled(bool);
    callback speed-changed(float);
    callback acceleration-changed(float);
    callback hud-toggled(bool);
    callback sounds-toggled(bool);
    callback sound-volume-changed(float);
    callback ui-sound-requested(string);
    callback profile-changed(string);
    callback binding-key-changed(int);
    callback binding-action-changed(int);
    callback reset-pointer-settings();
    callback reset-bindings();
    callback reset-defaults();
    callback runtime-events-ready();

    function binding-glyph(label: string) -> string {
        return label == "Up-left" ? "↖" :
            label == "Up" ? "↑" :
            label == "Up-right" ? "↗" :
            label == "Left" ? "←" :
            label == "Right" ? "→" :
            label == "Down-left" ? "↙" :
            label == "Down" ? "↓" :
            label == "Down-right" ? "↘" :
            label == "Click" || label == "Single click" ? "•" :
            label == "Double click" ? "••" :
            label == "Hold / drag" ? "⌁" :
            label == "Release" ? "↥" : "";
    }

    function binding-display(label: string) -> string {
        let glyph = root.binding-glyph(label);
        return glyph == "" ? label : glyph + "  " + label;
    }

    function mark-saved() {
        root.saved-visible = true;
        saved-timer.running = true;
        saved-timer.restart();
    }

    saved-timer := Timer {
        interval: 1600ms;
        running: false;
        triggered() => {
            root.saved-visible = false;
            self.running = false;
        }
    }

    reset-dialog := PopupWindow {
        width: 340px;
        height: 170px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        close-policy: close-on-click-outside;

        Rectangle {
            background: NumFlowTheme.surface-glass-elevated;
            border-width: 1px;
            border-color: NumFlowTheme.border-subtle;
            border-radius: NumFlowTheme.radius-large;
            drop-shadow-blur: NumFlowTheme.shadow-elevated-blur;
            drop-shadow-color: NumFlowTheme.shadow-elevated;
            drop-shadow-offset-y: 2px;

            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: 1px;
                background: NumFlowTheme.glass-highlight;
            }

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "Reset all NumFlow settings?";
                    color: NumFlowTheme.text-primary;
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    text: "Pointer settings, profiles, bindings and preferences will return to their defaults.";
                    color: NumFlowTheme.text-secondary;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Button { text: "Cancel"; clicked => { reset-dialog.close(); } }
                    UtilityButton {
                        reduced-motion: root.reduced-motion;
                        text: "Reset all";
                        destructive: true;
                        min-width: 76px;
                        clicked => {
                            root.reset-defaults();
                            root.mark-saved();
                            reset-dialog.close();
                        }
                    }
                }
            }
        }
    }

    more-menu := PopupWindow {
        width: 214px;
        height: 122px;
        x: root.width - self.width - 20px;
        y: root.height - self.height - 52px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: NumFlowTheme.surface-glass-elevated;
            border-width: 1px;
            border-color: NumFlowTheme.border-subtle;
            border-radius: NumFlowTheme.radius-medium;
            drop-shadow-blur: NumFlowTheme.shadow-elevated-blur;
            drop-shadow-color: NumFlowTheme.shadow-elevated;
            drop-shadow-offset-y: 2px;

            VerticalLayout {
                padding: 8px;
                spacing: 2px;

                MenuAction {

                    reduced-motion: root.reduced-motion;
                    text: "Reset pointer settings";
                    clicked => {
                        root.reset-pointer-settings();
                        root.mark-saved();
                        more-menu.close();
                    }
                }

                MenuAction {

                    reduced-motion: root.reduced-motion;
                    text: "Reset bindings";
                    clicked => {
                        root.reset-bindings();
                        root.mark-saved();
                        more-menu.close();
                    }
                }

                MenuAction {

                    reduced-motion: root.reduced-motion;
                    text: "Reset all settings…";
                    destructive: true;
                    clicked => {
                        root.ui-sound-requested("delete");
                        more-menu.close();
                        reset-dialog.show();
                    }
                }
            }
        }
    }

    bindings-panel := PopupWindow {
        width: 460px;
        height: 392px;
        x: (root.width - self.width) / 2;
        y: 10px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: NumFlowTheme.surface-glass-elevated;
            border-width: 1px;
            border-color: NumFlowTheme.border-subtle;
            border-radius: NumFlowTheme.radius-large;
            drop-shadow-blur: NumFlowTheme.shadow-elevated-blur;
            drop-shadow-color: NumFlowTheme.shadow-elevated;
            drop-shadow-offset-y: 2px;

            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: 1px;
                background: NumFlowTheme.glass-highlight;
            }

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                HorizontalLayout {
                    cross-axis-alignment: center;

                    VerticalLayout {
                        spacing: 1px;
                        Text { text: "Bindings"; color: NumFlowTheme.text-primary; font-size: 16px; font-weight: 600; }
                        Text { text: "Profile · " + root.active-profile; color: NumFlowTheme.text-secondary; font-size: 11px; }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    UtilityButton {

                        reduced-motion: root.reduced-motion;
                        text: "Done";
                        min-width: 58px;
                        clicked => { root.ui-sound-requested("close"); bindings-panel.close(); }
                    }
                }

                Separator { }

                Text { text: "Pointer movement"; color: NumFlowTheme.text-primary; font-size: 11px; font-weight: 600; }

                HorizontalLayout {
                    spacing: 24px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        MappingRow { key-label: "7"; action-label: root.binding-display(root.numpad-seven-label); }
                        MappingRow { key-label: "8"; action-label: root.binding-display(root.numpad-eight-label); }
                        MappingRow { key-label: "9"; action-label: root.binding-display(root.numpad-nine-label); }
                        MappingRow { key-label: "4"; action-label: root.binding-display(root.numpad-four-label); }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        MappingRow { key-label: "6"; action-label: root.binding-display(root.numpad-six-label); }
                        MappingRow { key-label: "1"; action-label: root.binding-display(root.numpad-one-label); }
                        MappingRow { key-label: "2"; action-label: root.binding-display(root.numpad-two-label); }
                        MappingRow { key-label: "3"; action-label: root.binding-display(root.numpad-three-label); }
                    }
                }

                Text { text: "Mouse"; color: NumFlowTheme.text-primary; font-size: 11px; font-weight: 600; }

                HorizontalLayout {
                    spacing: 24px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        MappingRow { key-label: "5"; action-label: root.binding-display(root.numpad-five-label); }
                        MappingRow { key-label: "0"; action-label: root.binding-display(root.numpad-zero-label); }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        MappingRow { key-label: "+"; action-label: root.binding-display(root.numpad-add-label); }
                        MappingRow { key-label: "Del"; action-label: root.binding-display(root.numpad-decimal-label); }
                    }
                }

                Separator { }

                Text { text: "Edit binding"; color: NumFlowTheme.text-primary; font-size: 11px; font-weight: 600; }

                HorizontalLayout {
                    spacing: 8px;

                    ComboBox {
                        horizontal-stretch: 1;
                        accessible-label: "NumPad key";
                        model: [
                            "Num 8", "Num 2", "Num 4", "Num 6", "Num 7",
                            "Num 9", "Num 1", "Num 3", "Num 5", "Num +",
                            "Num 0", "Num .", "Num /", "Num *", "Num -"
                        ];
                        current-index <=> root.binding-key-index;
                        selected(value) => { root.binding-key-changed(self.current-index); }
                    }

                    ComboBox {
                        horizontal-stretch: 2;
                        accessible-label: "Binding action";
                        model: [
                            "Unbound",
                            "Move up", "Move down", "Move left", "Move right",
                            "Move up-left", "Move up-right", "Move down-left", "Move down-right",
                            "Single click", "Double click", "Hold / drag", "Release",
                            "Select left button", "Select right button", "Select middle button",
                            "Precision on", "Precision off"
                        ];
                        current-index <=> root.binding-action-index;
                        selected(value) => {
                            root.binding-action-changed(self.current-index);
                            root.mark-saved();
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        background: root.platform-backdrop-available
            ? NumFlowTheme.window-material
            : NumFlowTheme.window-material-fallback;
        border-radius: NumFlowTheme.radius-large;
        clip: true;
        border-width: 1px;
        border-color: NumFlowTheme.border-subtle;
        drop-shadow-blur: NumFlowTheme.shadow-window-blur;
        drop-shadow-color: NumFlowTheme.shadow-window;
        drop-shadow-offset-y: 3px;

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: NumFlowTheme.background-glaze;
            opacity: root.platform-backdrop-available ? 1 : 0.82;
        }

        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: 1px;
            background: NumFlowTheme.glass-highlight;
        }

        VerticalLayout {
            padding-left: NumFlowTheme.spacing-lg;
            padding-right: NumFlowTheme.spacing-lg;
            padding-top: NumFlowTheme.spacing-lg;
            padding-bottom: 14px;
            spacing: 0px;

            Rectangle {
                min-height: 48px;
                max-height: 48px;
                border-radius: NumFlowTheme.radius-medium;
                background: root.numflow-enabled
                    ? NumFlowTheme.accent-muted
                    : NumFlowTheme.surface-glass-elevated;
                border-width: 1px;
                border-color: NumFlowTheme.border-subtle;

                HorizontalLayout {
                    padding-left: NumFlowTheme.spacing-md;
                    padding-right: NumFlowTheme.spacing-md;
                    spacing: NumFlowTheme.spacing-sm;
                    cross-axis-alignment: center;

                    Rectangle {
                        min-width: 12px;
                        max-width: 12px;
                        min-height: 12px;
                        max-height: 12px;
                        border-radius: 6px;
                        background: root.numflow-enabled ? NumFlowTheme.status-active : transparent;
                        border-width: root.numflow-enabled ? 0px : 1px;
                        border-color: NumFlowTheme.text-secondary;
                    }

                    VerticalLayout {
                        spacing: 0px;
                        Text {
                            text: root.numflow-enabled ? "Active" : "Inactive";
                            color: NumFlowTheme.text-primary;
                            font-size: 14px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.numflow-enabled ? "NumPad control is ready" : "NumPad control is paused";
                            color: NumFlowTheme.text-secondary;
                            font-size: 11px;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    Toggle {
                        a11y-label: "NumFlow activation";
                        checked <=> root.numflow-enabled;
                        reduced-motion: root.reduced-motion;
                        toggled(checked) => { root.enabled-toggled(checked); }
                    }

                    Text {
                        text: root.numflow-enabled ? "On" : "Off";
                        color: NumFlowTheme.text-secondary;
                        font-size: 11px;
                        min-width: 22px;
                        max-width: 22px;
                    }
                }
            }

            Rectangle { min-height: NumFlowTheme.spacing-lg; max-height: NumFlowTheme.spacing-lg; background: transparent; }

            Rectangle {
                min-height: 36px;
                max-height: 36px;
                background: transparent;

                HorizontalLayout {
                    spacing: NumFlowTheme.spacing-md;
                    cross-axis-alignment: center;

                    Text {
                        text: "Mouse";
                        color: NumFlowTheme.text-primary;
                        font-size: 12px;
                        font-weight: 500;
                        min-width: NumFlowTheme.label-column-width;
                        max-width: NumFlowTheme.label-column-width;
                    }

                    SegmentedControl {
                        horizontal-stretch: 1;
                        first-label: "Left";
                        second-label: "Right";
                        third-label: "Middle";
                        selected-index: root.active-button == MouseButtonMode.left ? 0 : root.active-button == MouseButtonMode.right ? 1 : 2;
                        reduced-motion: root.reduced-motion;
                        selected(index) => {
                            root.active-button = index == 0 ? MouseButtonMode.left : index == 1 ? MouseButtonMode.right : MouseButtonMode.middle;
                            root.mouse-button-changed(root.active-button);
                            root.mark-saved();
                        }
                    }
                }
            }

            Rectangle { min-height: NumFlowTheme.spacing-md; max-height: NumFlowTheme.spacing-md; background: transparent; }

            Rectangle {
                min-height: 36px;
                max-height: 36px;
                background: transparent;

                HorizontalLayout {
                    spacing: NumFlowTheme.spacing-md;
                    cross-axis-alignment: center;

                    Text {
                        text: "Profile";
                        color: NumFlowTheme.text-primary;
                        font-size: 12px;
                        font-weight: 500;
                        min-width: NumFlowTheme.label-column-width;
                        max-width: NumFlowTheme.label-column-width;
                    }

                    SegmentedControl {
                        horizontal-stretch: 1;
                        first-label: "Normal";
                        second-label: "Precision";
                        third-label: "Fast";
                        selected-index: root.active-profile == "Normal" ? 0 : root.active-profile == "Precision" ? 1 : 2;
                        reduced-motion: root.reduced-motion;
                        selected(index) => {
                            root.active-profile = index == 0 ? "Normal" : index == 1 ? "Precision" : "Fast";
                            root.profile-changed(root.active-profile);
                            root.ui-sound-requested("select");
                            root.mark-saved();
                        }
                    }
                }
            }

            Rectangle { min-height: 16px; max-height: 16px; background: transparent; }

            Rectangle {
                min-height: 32px;
                max-height: 32px;
                background: transparent;

                HorizontalLayout {
                        spacing: NumFlowTheme.spacing-md;
                    cross-axis-alignment: center;

                    Text {
                        text: "Speed";
                        color: NumFlowTheme.text-primary;
                        font-size: 12px;
                        font-weight: 500;
                        min-width: NumFlowTheme.label-column-width;
                        max-width: NumFlowTheme.label-column-width;
                    }

                    SliderControl {
                        horizontal-stretch: 1;
                        a11y-label: "Pointer speed";
                        minimum: 40;
                        maximum: 800;
                        step: 10;
                        value <=> root.pointer-speed;
                        changed(value) => {
                            root.speed-changed(value);
                            root.mark-saved();
                        }
                    }

                    Text {
                        text: "\{Math.round(root.pointer-speed)} px/s";
                        color: NumFlowTheme.text-secondary;
                        font-size: 11px;
                        font-weight: 500;
                        horizontal-alignment: right;
                        min-width: NumFlowTheme.value-column-width;
                        max-width: NumFlowTheme.value-column-width;
                    }
                }
            }

            Rectangle { min-height: NumFlowTheme.spacing-sm; max-height: NumFlowTheme.spacing-sm; background: transparent; }

            Rectangle {
                min-height: 32px;
                max-height: 32px;
                background: transparent;

                HorizontalLayout {
                        spacing: NumFlowTheme.spacing-md;
                    cross-axis-alignment: center;

                    Text {
                        text: "Acceleration";
                        color: NumFlowTheme.text-primary;
                        font-size: 12px;
                        font-weight: 500;
                        min-width: NumFlowTheme.label-column-width;
                        max-width: NumFlowTheme.label-column-width;
                    }

                    SliderControl {
                        horizontal-stretch: 1;
                        a11y-label: "Pointer acceleration";
                        minimum: 0;
                        maximum: 3000;
                        step: 50;
                        value <=> root.pointer-acceleration;
                        changed(value) => {
                            root.acceleration-changed(value);
                            root.mark-saved();
                        }
                    }

                    Text {
                        text: "\{Math.round(root.pointer-acceleration)} px/s²";
                        color: NumFlowTheme.text-secondary;
                        font-size: 11px;
                        font-weight: 500;
                        horizontal-alignment: right;
                        min-width: NumFlowTheme.value-column-width;
                        max-width: NumFlowTheme.value-column-width;
                    }
                }
            }

            Rectangle { min-height: NumFlowTheme.spacing-sm; max-height: NumFlowTheme.spacing-sm; background: transparent; }

            DisclosureRow {
                label: "Advanced";
                expanded: root.advanced-open;
                reduced-motion: root.reduced-motion;
                toggled => {
                    root.ui-sound-requested(root.advanced-open ? "collapse" : "expand");
                    root.advanced-open = !root.advanced-open;
                }
            }

            advanced-content := Rectangle {
                min-height: root.advanced-open ? 116px : 0px;
                max-height: root.advanced-open ? 116px : 0px;
                opacity: root.advanced-open ? 1 : 0;
                clip: true;
                background: root.advanced-open ? NumFlowTheme.surface-glass : transparent;
                border-width: root.advanced-open ? 1px : 0px;
                border-color: NumFlowTheme.border-subtle;
                border-radius: NumFlowTheme.radius-medium;

                animate min-height, max-height, opacity {
                    duration: root.reduced-motion ? 0ms : 160ms;
                    easing: ease-out;
                }

                VerticalLayout {
                    padding: NumFlowTheme.spacing-sm;
                    spacing: 6px;

                    Rectangle {
                        min-height: 32px;
                        max-height: 32px;
                        background: transparent;
                        HorizontalLayout {
                            spacing: NumFlowTheme.spacing-sm;
                            cross-axis-alignment: center;
                            VerticalLayout {
                                spacing: 1px;
                                Text { text: "Precision mode"; color: NumFlowTheme.text-primary; font-size: 12px; font-weight: 500; }
                                Text { text: "Reduce pointer speed for fine movement"; color: NumFlowTheme.text-secondary; font-size: 11px; }
                            }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Toggle {
                                enabled: root.advanced-open;
                                a11y-label: "Precision mode";
                                checked <=> root.precision-enabled;
                                reduced-motion: root.reduced-motion;
                                toggled(checked) => {
                                    root.precision-toggled(checked);
                                    root.mark-saved();
                                }
                            }
                        }
                    }

                    Rectangle {
                        min-height: 60px;
                        max-height: 60px;
                        background: transparent;
                        VerticalLayout {
                            spacing: 4px;

                            Rectangle {
                                min-height: 28px;
                                max-height: 28px;
                                background: transparent;
                                HorizontalLayout {
                                    spacing: NumFlowTheme.spacing-sm;
                                    cross-axis-alignment: center;
                                    VerticalLayout {
                                        spacing: 1px;
                                        Text { text: "Interface sounds"; color: NumFlowTheme.text-primary; font-size: 12px; font-weight: 500; }
                                        Text { text: "Play feedback sounds"; color: NumFlowTheme.text-secondary; font-size: 11px; }
                                    }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Toggle {
                                        enabled: root.advanced-open;
                                        a11y-label: "Interface sounds";
                                        checked <=> root.sounds-enabled;
                                        reduced-motion: root.reduced-motion;
                                        toggled(checked) => {
                                            root.sounds-toggled(checked);
                                            root.mark-saved();
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                min-height: 28px;
                                max-height: 28px;
                                background: transparent;
                                HorizontalLayout {
                                    spacing: NumFlowTheme.spacing-sm;
                                    cross-axis-alignment: center;

                                    Text {
                                        text: "Volume";
                                        color: NumFlowTheme.text-secondary;
                                        font-size: 11px;
                                        min-width: 48px;
                                        max-width: 48px;
                                    }

                                    SliderControl {
                                        horizontal-stretch: 1;
                                        enabled: root.advanced-open && root.sounds-enabled;
                                        a11y-label: "Sound volume";
                                        minimum: 0;
                                        maximum: 100;
                                        step: 5;
                                        value <=> root.sound-volume;
                                        changed(value) => {
                                            root.sound-volume-changed(value);
                                            root.mark-saved();
                                        }
                                    }

                                    Text {
                                        text: "\{Math.round(root.sound-volume)}%";
                                        color: NumFlowTheme.text-secondary;
                                        opacity: root.sounds-enabled ? 1 : 0.45;
                                        font-size: 11px;
                                        font-weight: 500;
                                        horizontal-alignment: right;
                                        min-width: 36px;
                                        max-width: 36px;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Separator { }

            Rectangle { min-height: 8px; max-height: 8px; background: transparent; }

            Rectangle {
                min-height: 34px;
                max-height: 34px;
                background: transparent;

                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;

                    Text {
                        text: "HUD";
                        color: NumFlowTheme.text-secondary;
                        font-size: 12px;
                        font-weight: 500;
                    }

                    Toggle {
                        a11y-label: "HUD";
                        checked <=> root.hud-enabled;
                        reduced-motion: root.reduced-motion;
                        toggled(checked) => {
                            root.hud-toggled(checked);
                            root.ui-sound-requested(checked ? "toggle-on" : "toggle-off");
                            root.mark-saved();
                        }
                    }

                    Text {
                        text: "✓ Saved";
                        color: NumFlowTheme.text-secondary;
                        font-size: 11px;
                        opacity: root.saved-visible ? 1 : 0;
                        animate opacity { duration: root.reduced-motion ? 0ms : 140ms; }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    UtilityButton {

                        reduced-motion: root.reduced-motion;
                        text: "Bindings…";
                        min-width: 82px;
                        clicked => { root.ui-sound-requested("open"); bindings-panel.show(); }
                    }

                    UtilityButton {

                        reduced-motion: root.reduced-motion;
                        text: "";
                        more-glyph: true;
                        a11y-label: "More options";
                        min-width: 34px;
                        max-width: 34px;
                        clicked => { root.ui-sound-requested("open"); more-menu.show(); }
                    }
                }
            }
        }
    }
}
