import { Button, ComboBox, Slider } from "std-widgets.slint";
import {
    DisclosureRow, GlassToggle, MappingRow, MenuAction, NumFlowTheme, SegmentedControl,
    Separator, UtilityButton
} from "design-system.slint";
export * from "hud.slint";

export enum MouseButtonMode {
    left,
    right,
    middle,
}

export component AppWindow inherits Window {
    title: "NumFlow";
    icon: @image-url("../assets/numflow-icon.svg");
    preferred-width: 600px;
    preferred-height: 420px;
    min-width: 540px;
    min-height: 390px;
    background: transparent;

    in-out property <bool> numflow-enabled: false;
    in-out property <float> pointer-speed: 180;
    in-out property <float> pointer-acceleration: 900;
    in-out property <bool> precision-enabled: false;
    in-out property <MouseButtonMode> active-button: MouseButtonMode.left;
    in-out property <string> active-key: "";
    in-out property <bool> hud-enabled: true;
    in-out property <string> active-profile: "Normal";
    in-out property <int> binding-key-index: 0;
    in-out property <int> binding-action-index: 1;
    in-out property <string> numpad-zero-label: "Hold / drag";
    in-out property <string> numpad-one-label: "Down-left";
    in-out property <string> numpad-two-label: "Down";
    in-out property <string> numpad-three-label: "Down-right";
    in-out property <string> numpad-four-label: "Left";
    in-out property <string> numpad-five-label: "Click";
    in-out property <string> numpad-six-label: "Right";
    in-out property <string> numpad-seven-label: "Up-left";
    in-out property <string> numpad-eight-label: "Up";
    in-out property <string> numpad-nine-label: "Up-right";
    in-out property <string> numpad-add-label: "Double click";
    in-out property <string> numpad-decimal-label: "Release";
    in property <bool> reduced-motion: false;

    private property <bool> advanced-open: false;
    private property <bool> saved-visible: false;

    callback enabled-toggled(bool);
    callback mouse-button-changed(MouseButtonMode);
    callback precision-toggled(bool);
    callback speed-changed(float);
    callback acceleration-changed(float);
    callback hud-toggled(bool);
    callback profile-changed(string);
    callback binding-key-changed(int);
    callback binding-action-changed(int);
    callback reset-pointer-settings();
    callback reset-bindings();
    callback reset-defaults();
    callback runtime-events-ready();

    function binding-glyph(label: string) -> string {
        return label == "Up-left" ? "↖" :
            label == "Up" ? "↑" :
            label == "Up-right" ? "↗" :
            label == "Left" ? "←" :
            label == "Right" ? "→" :
            label == "Down-left" ? "↙" :
            label == "Down" ? "↓" :
            label == "Down-right" ? "↘" :
            label == "Click" || label == "Single click" ? "•" :
            label == "Double click" ? "••" :
            label == "Hold / drag" ? "⌁" :
            label == "Release" ? "↥" : "";
    }

    function binding-display(label: string) -> string {
        let glyph = root.binding-glyph(label);
        return glyph == "" ? label : glyph + "  " + label;
    }

    function mark-saved() {
        root.saved-visible = true;
        saved-timer.running = true;
        saved-timer.restart();
    }

    saved-timer := Timer {
        interval: 1600ms;
        running: false;
        triggered() => {
            root.saved-visible = false;
            self.running = false;
        }
    }

    reset-dialog := PopupWindow {
        width: 360px;
        height: 170px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        close-policy: close-on-click-outside;

        Rectangle {
            background: NumFlowTheme.material;
            border-width: 1px;
            border-color: NumFlowTheme.separator;
            border-radius: NumFlowTheme.radius-large;

            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: 1px;
                background: #ffffff2a;
            }

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                Text {
                    text: "Reset all NumFlow settings?";
                    color: NumFlowTheme.label;
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    text: "Pointer settings, profiles, bindings and preferences will return to their defaults.";
                    color: NumFlowTheme.secondary-label;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; background: transparent; }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Button { text: "Cancel"; clicked => { reset-dialog.close(); } }
                    UtilityButton {
                        reduced-motion: root.reduced-motion;
                        text: "Reset all";
                        destructive: true;
                        min-width: 76px;
                        clicked => {
                            root.reset-defaults();
                            root.mark-saved();
                            reset-dialog.close();
                        }
                    }
                }
            }
        }
    }

    more-menu := PopupWindow {
        width: 214px;
        height: 122px;
        x: root.width - self.width - 20px;
        y: root.height - self.height - 52px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: NumFlowTheme.material;
            border-width: 1px;
            border-color: NumFlowTheme.separator;
            border-radius: NumFlowTheme.radius-medium;

            VerticalLayout {
                padding: 8px;
                spacing: 2px;

                MenuAction {

                    reduced-motion: root.reduced-motion;
                    text: "Reset pointer settings";
                    clicked => {
                        root.reset-pointer-settings();
                        root.mark-saved();
                        more-menu.close();
                    }
                }

                MenuAction {

                    reduced-motion: root.reduced-motion;
                    text: "Reset bindings";
                    clicked => {
                        root.reset-bindings();
                        root.mark-saved();
                        more-menu.close();
                    }
                }

                MenuAction {

                    reduced-motion: root.reduced-motion;
                    text: "Reset all settings…";
                    destructive: true;
                    clicked => {
                        more-menu.close();
                        reset-dialog.show();
                    }
                }
            }
        }
    }

    bindings-panel := PopupWindow {
        width: 510px;
        height: 392px;
        x: (root.width - self.width) / 2;
        y: 10px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: NumFlowTheme.material;
            border-width: 1px;
            border-color: NumFlowTheme.separator;
            border-radius: NumFlowTheme.radius-large;

            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: 1px;
                background: #ffffff2a;
            }

            VerticalLayout {
                padding: 18px;
                spacing: 10px;

                HorizontalLayout {
                    cross-axis-alignment: center;

                    VerticalLayout {
                        spacing: 1px;
                        Text { text: "Bindings"; color: NumFlowTheme.label; font-size: 16px; font-weight: 600; }
                        Text { text: "Profile · " + root.active-profile; color: NumFlowTheme.secondary-label; font-size: 10px; }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    UtilityButton {

                        reduced-motion: root.reduced-motion;
                        text: "Done";
                        min-width: 58px;
                        clicked => { bindings-panel.close(); }
                    }
                }

                Separator { }

                Text { text: "Pointer movement"; color: NumFlowTheme.label; font-size: 11px; font-weight: 600; }

                HorizontalLayout {
                    spacing: 24px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        MappingRow { key-label: "7"; action-label: root.binding-display(root.numpad-seven-label); }
                        MappingRow { key-label: "8"; action-label: root.binding-display(root.numpad-eight-label); }
                        MappingRow { key-label: "9"; action-label: root.binding-display(root.numpad-nine-label); }
                        MappingRow { key-label: "4"; action-label: root.binding-display(root.numpad-four-label); }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        MappingRow { key-label: "6"; action-label: root.binding-display(root.numpad-six-label); }
                        MappingRow { key-label: "1"; action-label: root.binding-display(root.numpad-one-label); }
                        MappingRow { key-label: "2"; action-label: root.binding-display(root.numpad-two-label); }
                        MappingRow { key-label: "3"; action-label: root.binding-display(root.numpad-three-label); }
                    }
                }

                Text { text: "Mouse"; color: NumFlowTheme.label; font-size: 11px; font-weight: 600; }

                HorizontalLayout {
                    spacing: 24px;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        MappingRow { key-label: "5"; action-label: root.binding-display(root.numpad-five-label); }
                        MappingRow { key-label: "0"; action-label: root.binding-display(root.numpad-zero-label); }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 1px;
                        MappingRow { key-label: "+"; action-label: root.binding-display(root.numpad-add-label); }
                        MappingRow { key-label: "Del"; action-label: root.binding-display(root.numpad-decimal-label); }
                    }
                }

                Separator { }

                Text { text: "Edit binding"; color: NumFlowTheme.label; font-size: 11px; font-weight: 600; }

                HorizontalLayout {
                    spacing: 8px;

                    ComboBox {
                        horizontal-stretch: 1;
                        accessible-label: "NumPad key";
                        model: [
                            "Num 8", "Num 2", "Num 4", "Num 6", "Num 7",
                            "Num 9", "Num 1", "Num 3", "Num 5", "Num +",
                            "Num 0", "Num .", "Num /", "Num *", "Num -"
                        ];
                        current-index <=> root.binding-key-index;
                        selected(value) => { root.binding-key-changed(self.current-index); }
                    }

                    ComboBox {
                        horizontal-stretch: 2;
                        accessible-label: "Binding action";
                        model: [
                            "Unbound",
                            "Move up", "Move down", "Move left", "Move right",
                            "Move up-left", "Move up-right", "Move down-left", "Move down-right",
                            "Single click", "Double click", "Hold / drag", "Release",
                            "Select left button", "Select right button", "Select middle button",
                            "Precision on", "Precision off"
                        ];
                        current-index <=> root.binding-action-index;
                        selected(value) => {
                            root.binding-action-changed(self.current-index);
                            root.mark-saved();
                        }
                    }
                }
            }
        }
    }

    Rectangle {
        background: NumFlowTheme.material;

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 1px;
            background: @linear-gradient(90deg, #0a84ff00 0%, #64d2ff24 24%, #ffffff2c 50%, #0a84ff18 76%, #0a84ff00 100%);
        }

        ambient-top := Rectangle {
            x: -88px;
            y: -148px;
            width: 430px;
            height: 300px;
            background: @radial-gradient(circle, #64d2ff14 0%, #0a84ff09 38%, #0a84ff00 72%);
            opacity: root.numflow-enabled ? 1 : 0.46;
            animate opacity {
                duration: root.reduced-motion ? 0ms : 220ms;
                easing: ease-out;
            }
        }

        Rectangle {
            x: parent.width - 250px;
            y: parent.height - 210px;
            width: 320px;
            height: 250px;
            background: @radial-gradient(circle, #0a84ff0c 0%, #0a84ff00 70%);
        }

        VerticalLayout {
            padding-left: 22px;
            padding-right: 22px;
            padding-top: 18px;
            padding-bottom: 18px;
            spacing: 0px;

            Rectangle {
                min-height: 38px;
                max-height: 38px;
                background: transparent;

                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;

                    Rectangle {
                        min-width: 14px;
                        max-width: 14px;
                        min-height: 14px;
                        max-height: 14px;
                        background: transparent;

                        Rectangle {
                            x: 0px;
                            y: 0px;
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            background: #30d15820;
                            opacity: root.numflow-enabled ? 1 : 0;
                            animate opacity {
                                duration: root.reduced-motion ? 0ms : 180ms;
                                easing: ease-out;
                            }
                        }

                        Rectangle {
                            x: 4px;
                            y: 4px;
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: root.numflow-enabled ? NumFlowTheme.status-active : transparent;
                            border-width: root.numflow-enabled ? 0px : 1px;
                            border-color: NumFlowTheme.secondary-label;
                            drop-shadow-blur: root.numflow-enabled ? 6px : 0px;
                            drop-shadow-color: #30d15872;
                            animate background {
                                duration: root.reduced-motion ? 0ms : 180ms;
                                easing: ease-out;
                            }
                        }
                    }

                    Text {
                        text: root.numflow-enabled ? "Active" : "Disabled";
                        color: NumFlowTheme.label;
                        font-size: 13px;
                        font-weight: 550;
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    GlassToggle {
                        a11y-label: "NumFlow";
                        checked <=> root.numflow-enabled;
                        reduced-motion: root.reduced-motion;
                        toggled(checked) => { root.enabled-toggled(checked); }
                    }

                    Text {
                        text: root.numflow-enabled ? "On" : "Off";
                        color: NumFlowTheme.secondary-label;
                        font-size: 11px;
                        min-width: 22px;
                        max-width: 22px;
                    }
                }
            }

            Rectangle { min-height: 16px; max-height: 16px; background: transparent; }

            Rectangle {
                min-height: 36px;
                max-height: 36px;
                background: transparent;

                HorizontalLayout {
                    spacing: 14px;
                    cross-axis-alignment: center;

                    Text {
                        text: "Mouse";
                        color: NumFlowTheme.label;
                        font-size: 12px;
                        font-weight: 500;
                        min-width: 86px;
                        max-width: 86px;
                    }

                    SegmentedControl {
                        horizontal-stretch: 1;
                        first-label: "Left";
                        second-label: "Right";
                        third-label: "Middle";
                        selected-index: root.active-button == MouseButtonMode.left ? 0 : root.active-button == MouseButtonMode.right ? 1 : 2;
                        reduced-motion: root.reduced-motion;
                        selected(index) => {
                            root.active-button = index == 0 ? MouseButtonMode.left : index == 1 ? MouseButtonMode.right : MouseButtonMode.middle;
                            root.mouse-button-changed(root.active-button);
                            root.mark-saved();
                        }
                    }
                }
            }

            Rectangle { min-height: 12px; max-height: 12px; background: transparent; }

            Rectangle {
                min-height: 36px;
                max-height: 36px;
                background: transparent;

                HorizontalLayout {
                    spacing: 14px;
                    cross-axis-alignment: center;

                    Text {
                        text: "Pointer";
                        color: NumFlowTheme.label;
                        font-size: 12px;
                        font-weight: 500;
                        min-width: 86px;
                        max-width: 86px;
                    }

                    SegmentedControl {
                        horizontal-stretch: 1;
                        first-label: "Normal";
                        second-label: "Precision";
                        third-label: "Fast";
                        selected-index: root.active-profile == "Normal" ? 0 : root.active-profile == "Precision" ? 1 : 2;
                        reduced-motion: root.reduced-motion;
                        selected(index) => {
                            root.active-profile = index == 0 ? "Normal" : index == 1 ? "Precision" : "Fast";
                            root.profile-changed(root.active-profile);
                            root.mark-saved();
                        }
                    }
                }
            }

            Rectangle { min-height: 20px; max-height: 20px; background: transparent; }

            Rectangle {
                min-height: 32px;
                max-height: 32px;
                background: transparent;

                HorizontalLayout {
                    spacing: 12px;
                    cross-axis-alignment: center;

                    Text {
                        text: "Speed";
                        color: NumFlowTheme.label;
                        font-size: 12px;
                        font-weight: 500;
                        min-width: 86px;
                        max-width: 86px;
                    }

                    Slider {
                        horizontal-stretch: 1;
                        accessible-label: "Pointer speed";
                        minimum: 40;
                        maximum: 800;
                        step: 10;
                        value <=> root.pointer-speed;
                        changed(value) => {
                            root.speed-changed(value);
                            root.mark-saved();
                        }
                    }

                    Text {
                        text: "\{Math.round(root.pointer-speed)} px/s";
                        color: NumFlowTheme.secondary-label;
                        font-size: 11px;
                        font-weight: 500;
                        horizontal-alignment: right;
                        min-width: 74px;
                        max-width: 74px;
                    }
                }
            }

            Rectangle { min-height: 10px; max-height: 10px; background: transparent; }

            Rectangle {
                min-height: 32px;
                max-height: 32px;
                background: transparent;

                HorizontalLayout {
                    spacing: 12px;
                    cross-axis-alignment: center;

                    Text {
                        text: "Acceleration";
                        color: NumFlowTheme.label;
                        font-size: 12px;
                        font-weight: 500;
                        min-width: 86px;
                        max-width: 86px;
                    }

                    Slider {
                        horizontal-stretch: 1;
                        accessible-label: "Pointer acceleration";
                        minimum: 0;
                        maximum: 3000;
                        step: 50;
                        value <=> root.pointer-acceleration;
                        changed(value) => {
                            root.acceleration-changed(value);
                            root.mark-saved();
                        }
                    }

                    Text {
                        text: "\{Math.round(root.pointer-acceleration)} px/s²";
                        color: NumFlowTheme.secondary-label;
                        font-size: 11px;
                        font-weight: 500;
                        horizontal-alignment: right;
                        min-width: 74px;
                        max-width: 74px;
                    }
                }
            }

            Rectangle { min-height: 14px; max-height: 14px; background: transparent; }

            DisclosureRow {
                label: "Advanced";
                expanded: root.advanced-open;
                reduced-motion: root.reduced-motion;
                toggled => { root.advanced-open = !root.advanced-open; }
            }

            advanced-content := Rectangle {
                min-height: root.advanced-open ? 54px : 0px;
                max-height: root.advanced-open ? 54px : 0px;
                opacity: root.advanced-open ? 1 : 0;
                clip: true;
                background: transparent;

                animate min-height, max-height, opacity {
                    duration: root.reduced-motion ? 0ms : 210ms;
                    easing: ease-out;
                }

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 2px;
                    spacing: 12px;
                    cross-axis-alignment: center;

                    VerticalLayout {
                        spacing: 1px;
                        Text { text: "Precision mode"; color: NumFlowTheme.label; font-size: 12px; font-weight: 500; }
                        Text { text: "Reduce pointer speed for fine movement"; color: NumFlowTheme.secondary-label; font-size: 10px; }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    Text {
                        text: root.precision-enabled ? "On" : "Off";
                        color: NumFlowTheme.secondary-label;
                        font-size: 10px;
                    }

                    GlassToggle {
                        enabled: root.advanced-open;
                        a11y-label: "Precision mode";
                        checked <=> root.precision-enabled;
                        reduced-motion: root.reduced-motion;
                        toggled(checked) => {
                            root.precision-toggled(checked);
                            root.mark-saved();
                        }
                    }
                }
            }

            Rectangle { vertical-stretch: 1; background: transparent; }

            Separator { }

            Rectangle { min-height: 10px; max-height: 10px; background: transparent; }

            Rectangle {
                min-height: 34px;
                max-height: 34px;
                background: transparent;

                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;

                    Text {
                        text: "HUD";
                        color: NumFlowTheme.label;
                        font-size: 12px;
                        font-weight: 500;
                    }

                    GlassToggle {
                        a11y-label: "HUD";
                        checked <=> root.hud-enabled;
                        reduced-motion: root.reduced-motion;
                        toggled(checked) => {
                            root.hud-toggled(checked);
                            root.mark-saved();
                        }
                    }

                    Text {
                        text: "✓ Saved";
                        color: NumFlowTheme.secondary-label;
                        font-size: 10px;
                        opacity: root.saved-visible ? 1 : 0;
                        animate opacity { duration: root.reduced-motion ? 0ms : 140ms; }
                    }

                    Rectangle { horizontal-stretch: 1; background: transparent; }

                    UtilityButton {

                        reduced-motion: root.reduced-motion;
                        text: "Bindings…";
                        min-width: 82px;
                        clicked => { bindings-panel.show(); }
                    }

                    UtilityButton {

                        reduced-motion: root.reduced-motion;
                        text: "⋯";
                        min-width: 34px;
                        max-width: 34px;
                        clicked => { more-menu.show(); }
                    }
                }
            }
        }
    }
}
