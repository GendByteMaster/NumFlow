import { Button, ComboBox, ScrollView, Slider, Switch } from "std-widgets.slint";
import { KeyTile, NumFlowTheme, SectionTitle, SegmentedOption, Separator } from "design-system.slint";
export * from "hud.slint";

export enum MouseButtonMode {
    left,
    right,
    middle,
}

export component AppWindow inherits Window {
    title: "NumFlow";
    icon: @image-url("../assets/numflow-icon.svg");
    preferred-width: 600px;
    preferred-height: 690px;
    min-width: 520px;
    min-height: 500px;
    background: NumFlowTheme.background;

    in-out property <bool> numflow-enabled: false;
    in-out property <float> pointer-speed: 180;
    in-out property <float> pointer-acceleration: 900;
    in-out property <bool> precision-enabled: false;
    in-out property <MouseButtonMode> active-button: MouseButtonMode.left;
    in-out property <string> active-key: "";
    in-out property <bool> hud-enabled: true;
    in-out property <string> active-profile: "Normal";
    in-out property <int> binding-key-index: 0;
    in-out property <int> binding-action-index: 1;
    in-out property <string> numpad-zero-label: "Hold / drag";
    in-out property <string> numpad-one-label: "Down-left";
    in-out property <string> numpad-two-label: "Down";
    in-out property <string> numpad-three-label: "Down-right";
    in-out property <string> numpad-four-label: "Left";
    in-out property <string> numpad-five-label: "Click";
    in-out property <string> numpad-six-label: "Right";
    in-out property <string> numpad-seven-label: "Up-left";
    in-out property <string> numpad-eight-label: "Up";
    in-out property <string> numpad-nine-label: "Up-right";
    in-out property <string> numpad-add-label: "Double click";
    in-out property <string> numpad-decimal-label: "Release";

    private property <bool> bindings-editor-visible: false;

    callback enabled-toggled(bool);
    callback mouse-button-changed(MouseButtonMode);
    callback precision-toggled(bool);
    callback speed-changed(float);
    callback acceleration-changed(float);
    callback hud-toggled(bool);
    callback profile-changed(string);
    callback binding-key-changed(int);
    callback binding-action-changed(int);
    callback reset-bindings();
    callback reset-defaults();
    callback runtime-events-ready();

    private property <string> active-button-label:
        root.active-button == MouseButtonMode.left ? "Left" :
        root.active-button == MouseButtonMode.right ? "Right" : "Middle";

    private property <image> active-button-icon:
        root.active-button == MouseButtonMode.left
            ? @image-url("../assets/icons/numflow/mouse-left.svg")
            : root.active-button == MouseButtonMode.right
                ? @image-url("../assets/icons/numflow/mouse-right.svg")
                : @image-url("../assets/icons/numflow/mouse-middle.svg");

    reset-dialog := PopupWindow {
        width: 352px;
        height: 168px;
        x: root.width - self.width - 16px;
        y: root.height - self.height - 52px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: NumFlowTheme.surface;
            border-width: 1px;
            border-color: NumFlowTheme.separator;
            border-radius: 12px;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Text {
                    text: "Reset NumFlow settings?";
                    color: NumFlowTheme.label;
                    font-size: 15px;
                    font-weight: 600;
                }

                Text {
                    text: "Pointer settings, profiles, bindings and preferences will return to their defaults.";
                    color: NumFlowTheme.secondary-label;
                    font-size: 11px;
                    wrap: word-wrap;
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Button {
                        text: "Cancel";
                        clicked => { reset-dialog.close(); }
                    }

                    Button {
                        text: "Reset";
                        clicked => {
                            root.reset-defaults();
                            reset-dialog.close();
                        }
                    }
                }
            }
        }
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            min-height: 66px;
            max-height: 66px;
            background: transparent;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 11px;
                padding-bottom: 11px;
                spacing: 10px;
                cross-axis-alignment: center;

                Image {
                    source: @image-url("../assets/numflow-icon.svg");
                    min-width: 32px;
                    max-width: 32px;
                    min-height: 32px;
                    max-height: 32px;
                    image-fit: contain;
                    accessible-role: none;
                }

                VerticalLayout {
                    spacing: 1px;
                    alignment: center;

                    Text {
                        text: "NumFlow";
                        color: NumFlowTheme.label;
                        font-size: 20px;
                        font-weight: 600;
                    }

                    Text {
                        text: "Precise pointer control from your keyboard";
                        color: NumFlowTheme.secondary-label;
                        font-size: 11px;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                Switch {
                    accessible-label: "NumFlow";
                    text: root.numflow-enabled ? "On" : "Off";
                    checked <=> root.numflow-enabled;
                    toggled => { root.enabled-toggled(self.checked); }
                }
            }
        }

        Separator { }

        Rectangle {
            min-height: 40px;
            max-height: 40px;
            background: NumFlowTheme.surface;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 18px;
                cross-axis-alignment: center;

                HorizontalLayout {
                    spacing: 6px;
                    cross-axis-alignment: center;

                    Text {
                        text: root.numflow-enabled ? "●" : "○";
                        color: root.numflow-enabled ? NumFlowTheme.accent : NumFlowTheme.secondary-label;
                        font-size: 12px;
                    }

                    Text {
                        text: root.numflow-enabled ? "Active" : "Inactive";
                        color: NumFlowTheme.label;
                        font-size: 12px;
                        font-weight: 600;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    cross-axis-alignment: center;

                    Image {
                        source: root.active-button-icon;
                        min-width: 18px;
                        max-width: 18px;
                        min-height: 18px;
                        max-height: 18px;
                        image-fit: contain;
                        accessible-role: none;
                    }

                    Text {
                        text: "Mouse: " + root.active-button-label;
                        color: NumFlowTheme.label;
                        font-size: 12px;
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    cross-axis-alignment: center;

                    Image {
                        source: @image-url("../assets/icons/numflow/precision-mode.svg");
                        min-width: 17px;
                        max-width: 17px;
                        min-height: 17px;
                        max-height: 17px;
                        image-fit: contain;
                        accessible-role: none;
                    }

                    Text {
                        text: "Precision: " + (root.precision-enabled ? "On" : "Off");
                        color: NumFlowTheme.label;
                        font-size: 12px;
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }
            }
        }

        Separator { }

        ScrollView {
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            vertical-scrollbar-policy: as-needed;
            mouse-drag-pan-enabled: false;

            VerticalLayout {
                min-width: 480px;
                padding: 16px;
                spacing: 18px;

                VerticalLayout {
                    spacing: 8px;

                    SectionTitle { label: "NumPad"; }

                    HorizontalLayout {
                        spacing: 8px;
                        KeyTile { horizontal-stretch: 1; key-label: "↖ 7"; action-label: root.numpad-seven-label; active: root.active-key == "7"; }
                        KeyTile { horizontal-stretch: 1; key-label: "↑ 8"; action-label: root.numpad-eight-label; active: root.active-key == "8"; }
                        KeyTile { horizontal-stretch: 1; key-label: "9 ↗"; action-label: root.numpad-nine-label; active: root.active-key == "9"; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        KeyTile { horizontal-stretch: 1; key-label: "← 4"; action-label: root.numpad-four-label; active: root.active-key == "4"; }
                        KeyTile { horizontal-stretch: 1; key-label: "5"; action-label: root.numpad-five-label; active: root.active-key == "5"; }
                        KeyTile { horizontal-stretch: 1; key-label: "6 →"; action-label: root.numpad-six-label; active: root.active-key == "6"; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        KeyTile { horizontal-stretch: 1; key-label: "↙ 1"; action-label: root.numpad-one-label; active: root.active-key == "1"; }
                        KeyTile { horizontal-stretch: 1; key-label: "↓ 2"; action-label: root.numpad-two-label; active: root.active-key == "2"; }
                        KeyTile { horizontal-stretch: 1; key-label: "3 ↘"; action-label: root.numpad-three-label; active: root.active-key == "3"; }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        KeyTile { horizontal-stretch: 1; key-label: "0"; action-label: root.numpad-zero-label; active: root.active-key == "0"; }
                        KeyTile { horizontal-stretch: 1; key-label: "+"; action-label: root.numpad-add-label; active: root.active-key == "+"; }
                        KeyTile { horizontal-stretch: 1; key-label: ". / Del"; action-label: root.numpad-decimal-label; active: root.active-key == "."; }
                    }
                }

                VerticalLayout {
                    spacing: 8px;

                    SectionTitle { label: "Mouse Button"; }

                    Rectangle {
                        min-height: 38px;
                        max-height: 38px;
                        background: NumFlowTheme.surface;
                        border-width: 1px;
                        border-color: NumFlowTheme.separator;
                        border-radius: NumFlowTheme.radius-medium;

                        HorizontalLayout {
                            padding: 3px;
                            spacing: 3px;

                            SegmentedOption {
                                horizontal-stretch: 1;
                                label: "Left";
                                selected: root.active-button == MouseButtonMode.left;
                                clicked => { root.active-button = MouseButtonMode.left; root.mouse-button-changed(MouseButtonMode.left); }
                            }

                            SegmentedOption {
                                horizontal-stretch: 1;
                                label: "Right";
                                selected: root.active-button == MouseButtonMode.right;
                                clicked => { root.active-button = MouseButtonMode.right; root.mouse-button-changed(MouseButtonMode.right); }
                            }

                            SegmentedOption {
                                horizontal-stretch: 1;
                                label: "Middle";
                                selected: root.active-button == MouseButtonMode.middle;
                                clicked => { root.active-button = MouseButtonMode.middle; root.mouse-button-changed(MouseButtonMode.middle); }
                            }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 9px;

                    SectionTitle { label: "Pointer"; }

                    Rectangle {
                        min-height: 38px;
                        max-height: 38px;
                        background: NumFlowTheme.surface;
                        border-width: 1px;
                        border-color: NumFlowTheme.separator;
                        border-radius: NumFlowTheme.radius-medium;

                        HorizontalLayout {
                            padding: 3px;
                            spacing: 3px;

                            SegmentedOption {
                                horizontal-stretch: 1;
                                label: "Normal";
                                selected: root.active-profile == "Normal";
                                clicked => { root.active-profile = "Normal"; root.profile-changed("Normal"); }
                            }

                            SegmentedOption {
                                horizontal-stretch: 1;
                                label: "Precision";
                                selected: root.active-profile == "Precision";
                                clicked => { root.active-profile = "Precision"; root.profile-changed("Precision"); }
                            }

                            SegmentedOption {
                                horizontal-stretch: 1;
                                label: "Fast";
                                selected: root.active-profile == "Fast";
                                clicked => { root.active-profile = "Fast"; root.profile-changed("Fast"); }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;

                        HorizontalLayout {
                            Text { text: "Speed"; color: NumFlowTheme.label; font-size: 12px; font-weight: 500; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: "\{Math.round(root.pointer-speed)} px/s"; color: NumFlowTheme.secondary-label; font-size: 11px; }
                        }

                        Slider {
                            accessible-label: "Pointer speed";
                            minimum: 40;
                            maximum: 800;
                            step: 10;
                            value <=> root.pointer-speed;
                            changed(value) => { root.speed-changed(value); }
                        }

                        HorizontalLayout {
                            Text { text: "40"; color: NumFlowTheme.secondary-label; font-size: 10px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: "800"; color: NumFlowTheme.secondary-label; font-size: 10px; }
                        }
                    }

                    VerticalLayout {
                        spacing: 3px;

                        HorizontalLayout {
                            Text { text: "Acceleration"; color: NumFlowTheme.label; font-size: 12px; font-weight: 500; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: "\{Math.round(root.pointer-acceleration)} px/s²"; color: NumFlowTheme.secondary-label; font-size: 11px; }
                        }

                        Slider {
                            accessible-label: "Pointer acceleration";
                            minimum: 0;
                            maximum: 3000;
                            step: 50;
                            value <=> root.pointer-acceleration;
                            changed(value) => { root.acceleration-changed(value); }
                        }

                        HorizontalLayout {
                            Text { text: "0"; color: NumFlowTheme.secondary-label; font-size: 10px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: "3000"; color: NumFlowTheme.secondary-label; font-size: 10px; }
                        }
                    }

                    Rectangle {
                        min-height: 48px;
                        background: transparent;

                        HorizontalLayout {
                            spacing: 12px;
                            cross-axis-alignment: center;

                            VerticalLayout {
                                spacing: 1px;
                                Text { text: "Precision mode"; color: NumFlowTheme.label; font-size: 12px; font-weight: 500; }
                                Text { text: "Reduce pointer speed for precise movement"; color: NumFlowTheme.secondary-label; font-size: 10px; }
                            }

                            Rectangle { horizontal-stretch: 1; background: transparent; }

                            Switch {
                                accessible-label: "Precision mode";
                                text: root.precision-enabled ? "On" : "Off";
                                checked <=> root.precision-enabled;
                                toggled => { root.precision-toggled(self.checked); }
                            }
                        }
                    }
                }

                if root.bindings-editor-visible: VerticalLayout {
                    spacing: 8px;

                    Separator { }

                    HorizontalLayout {
                        SectionTitle { label: "Key bindings · " + root.active-profile; }
                        Rectangle { horizontal-stretch: 1; background: transparent; }
                        Text { text: "Changes apply immediately"; color: NumFlowTheme.secondary-label; font-size: 10px; vertical-alignment: center; }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        ComboBox {
                            horizontal-stretch: 1;
                            accessible-label: "NumPad key";
                            model: [
                                "Num 8", "Num 2", "Num 4", "Num 6", "Num 7",
                                "Num 9", "Num 1", "Num 3", "Num 5", "Num +",
                                "Num 0", "Num .", "Num /", "Num *", "Num -"
                            ];
                            current-index <=> root.binding-key-index;
                            selected(value) => { root.binding-key-changed(self.current-index); }
                        }

                        ComboBox {
                            horizontal-stretch: 2;
                            accessible-label: "Binding action";
                            model: [
                                "Unbound",
                                "Move up", "Move down", "Move left", "Move right",
                                "Move up-left", "Move up-right", "Move down-left", "Move down-right",
                                "Single click", "Double click", "Hold / drag", "Release",
                                "Select left button", "Select right button", "Select middle button",
                                "Precision on", "Precision off"
                            ];
                            current-index <=> root.binding-action-index;
                            selected(value) => { root.binding-action-changed(self.current-index); }
                        }

                        Button { text: "Reset bindings"; clicked => { root.reset-bindings(); } }
                    }
                }
            }
        }

        Separator { }

        Rectangle {
            min-height: 46px;
            max-height: 46px;
            background: NumFlowTheme.surface;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                cross-axis-alignment: center;

                Text { text: "✓ Saved automatically"; color: NumFlowTheme.secondary-label; font-size: 10px; }
                Rectangle { horizontal-stretch: 1; background: transparent; }

                Switch {
                    accessible-label: "HUD";
                    text: "HUD";
                    checked <=> root.hud-enabled;
                    toggled => { root.hud-toggled(self.checked); }
                }

                Button {
                    text: root.bindings-editor-visible ? "Done" : "Bindings…";
                    clicked => { root.bindings-editor-visible = !root.bindings-editor-visible; }
                }

                Button { text: "Reset…"; clicked => { reset-dialog.show(); } }
            }
        }
    }
}
