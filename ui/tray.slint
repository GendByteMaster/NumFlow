export component AppTray inherits SystemTrayIcon {
    icon: @image-url("../assets/numflow-icon.svg");
    title: "NumFlow";
    tooltip: root.numflow-enabled
        ? "NumFlow · On · Running in background"
        : "NumFlow · Off · Running in background";

    in-out property <bool> numflow-enabled: true;
    in-out property <bool> start-minimized: false;
    in-out property <bool> start-with-windows: false;

    callback open-settings();
    callback enabled-toggled(bool);
    callback start-minimized-toggled(bool);
    callback start-with-windows-toggled(bool);
    callback exit-requested();

    clicked => {
        root.open-settings();
    }

    Menu {
        MenuItem {
            title: "Open NumFlow";
            activated => {
                root.open-settings();
            }
        }

        MenuSeparator {}

        MenuItem {
            title: root.numflow-enabled ? "NumFlow On" : "NumFlow Off";
            checkable: true;
            checked: root.numflow-enabled;
            activated => {
                root.numflow-enabled = !root.numflow-enabled;
                root.enabled-toggled(root.numflow-enabled);
            }
        }

        MenuItem {
            title: "Running in background";
            enabled: false;
        }

        MenuSeparator {}

        MenuItem {
            title: "Start minimized";
            checkable: true;
            checked: root.start-minimized;
            activated => {
                root.start-minimized = !root.start-minimized;
                root.start-minimized-toggled(root.start-minimized);
            }
        }

        MenuItem {
            title: "Start with Windows";
            checkable: true;
            checked: root.start-with-windows;
            activated => {
                root.start-with-windows = !root.start-with-windows;
                root.start-with-windows-toggled(root.start-with-windows);
            }
        }

        MenuSeparator {}

        MenuItem {
            title: "Exit NumFlow";
            activated => {
                root.exit-requested();
            }
        }
    }
}
